SECRET_KEY=dev-secret-key-emergency-ai-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-emergency-ai-change-in-production
# MySQL connection format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Note: If MySQL is not reachable or credentials fail, the backend safely falls back to local SQLite automatically.
DATABASE_URL=mysql+pymysql://emergency:emergency123@127.0.0.1:3306/emergency_ai
UPLOAD_FOLDER=uploads
FRONTEND_ORIGIN=*
PORT=5000
